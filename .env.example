# Copy this file to .env and fill in real values. Never commit .env.
# Neon connection string (Neon Console -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:5172

# Used by `python -m scripts.init_db` to create the first admin + room
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ROOM_NAME=My Room
