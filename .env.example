# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string.
#   Atlas (cloud):  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
#   Local:          mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
# Database name inside that server (created automatically on first write)
MONGODB_DB=room_management

# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Site(s) allowed to call this API, comma-separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# Used by `python -m scripts.seed_admin` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
